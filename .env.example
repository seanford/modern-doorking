# DoorKing Device Configuration
DOORKING_HOST=192.168.1.40
DOORKING_PORT=1030
# Note: Port 1030 is for gate control (based on DoorKing 1812AP protocol)
# Port 23 may be used for management/RS-232 commands
DOORKING_USERNAME=admin
DOORKING_PASSWORD=admin

# Server Configuration
PORT=3000
NODE_ENV=development

# Session Configuration
SESSION_TIMEOUT=3600000
