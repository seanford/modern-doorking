{
  "name": "modern-doorking",
  "version": "1.0.0",
  "description": "Modern web interface for DoorKing 1830 access control system",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test-device": "tsx src/test-connection.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "doorking",
    "access-control",
    "tcp",
    "1830"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/node": "^20.9.0",
    "@types/ws": "^8.5.8",
    "@types/cors": "^2.8.15",
    "typescript": "^5.2.2",
    "tsx": "^4.6.2",
    "prettier": "^3.1.0",
    "eslint": "^8.53.0",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0"
  }
}
